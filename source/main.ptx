  <book xml:id="stat-cookbook">
    <title>Probability and Statistics Cookbook</title>
    <subtitle>A Comprehensive Mathematical Reference</subtitle>

    <frontmatter xml:id="frontmatter">
      <titlepage>
        <author>
          <personname>Matthias Vallentin</personname>
          <email>matthias@berkeley.edu</email>
        </author>
        <date><today /></date>
      </titlepage>

      <colophon>
        <edition>Version 0.2.7</edition>
        <website>
          <url href="http://statistics.zone">http://statistics.zone</url>
        </website>
        <copyright>
          <year>2017</year>
          <holder>Matthias Vallentin</holder>
          <minilicense>CC BY-NC-SA 4.0 License</minilicense>
          <shortlicense>
            This work is licensed under the Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License.
            To view a copy of this license, visit
            <url href="http://creativecommons.org/licenses/by-nc-sa/4.0/">http://creativecommons.org/licenses/by-nc-sa/4.0/</url>.
          </shortlicense>
        </copyright>
      </colophon>

      <preface>
        <p>
          This cookbook integrates various topics in probability theory and statistics.
          It provides a succinct representation of various topics, offering a comprehensive
          mathematical reference reduced to its essence, rather than aiming for elaborate explanations.
        </p>
        <p>
          The content is based on literature and in-class material from courses of the
          statistics department at the University of California in Berkeley.
        </p>
        <p>
          If you find errors or have suggestions for improvements, please visit
          <url href="http://statistics.zone">http://statistics.zone</url>.
        </p>
      </preface>
    </frontmatter>

